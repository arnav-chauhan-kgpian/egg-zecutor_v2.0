# Reference for running the API directly on the host (`npm run dev`), outside
# Docker.
#
# For the normal Docker workflow you do NOT need to copy this: ./setup.sh or
# .\setup.ps1 generates a complete `.env` with real secrets.

# --------------------------------------------------------------------- database
# Host-side port published by the `postgres` service in docker-compose.yml.
# 5435 avoids a local Postgres on 5432/5433 and sits clear of the Windows
# Hyper-V/WSL2 reserved port blocks.
POSTGRES_PORT=5435

# Host-side connection string, used by the Prisma CLI and `npm run dev`. It
# points at localhost:${POSTGRES_PORT}; containers do not use this value —
# docker-compose.yml derives theirs from POSTGRES_* and the service name.
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/hackerrank_clone?schema=public"

# ------------------------------------------------------------------ http / auth
PORT=4000
NODE_ENV=development
CORS_ORIGIN="*"
# Must exceed ADDITIONAL_FILES_MAX_BASE64_BYTES or dataset uploads are rejected
# by the body parser before the route sees them.
REQUEST_BODY_LIMIT=64mb

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=10

# ------------------------------------------------------------ execution backend
# judge0 — the intended engine; needs JUDGE0_API_URL and a cgroup v1 host
# docker — run locally in throwaway containers; works on cgroup v2
# auto   — judge0 when JUDGE0_API_URL is set, otherwise docker
# Which backend runs submitted code:
#   docker  one throwaway container per run (sandboxed, needs Docker)
#   judge0  a Judge0 server (sandboxed, needs JUDGE0_API_URL + a cgroup v1 host)
#   native  a child process of the API — NO SANDBOX, but needs no Docker
#   auto    judge0 if configured, else docker if its daemon answers, else native
EXECUTOR=docker

# Interface the API listens on. Leave as loopback unless you know why not:
# with EXECUTOR=native, a public bind hands arbitrary code execution to the
# network, and the API refuses to start that way without the override below.
HOST=127.0.0.1
# EXECUTOR_NATIVE_ALLOW_REMOTE=true

# Empty unless you have a reachable Judge0. Judge0 1.13.x cannot sandbox on a
# cgroup v2 host (Docker Desktop/WSL2, modern Linux) — see the README.
JUDGE0_API_URL=""
# Only needed for RapidAPI-hosted instances.
JUDGE0_API_KEY=""
JUDGE0_API_HOST="judge0-ce.p.rapidapi.com"
# Self-hosted instances with JUDGE0_AUTHN_TOKEN set expect X-Auth-Token.
JUDGE0_AUTH_TOKEN=""

# Webhook Judge0 posts finished submissions to. Must be reachable FROM Judge0,
# so running the API on the host means a host-reachable URL, not a service name.
JUDGE0_CALLBACK_URL=""
JUDGE0_CALLBACK_SECRET=""

# ---------------------------------------------------------------- run limits
# Research defaults (seconds / KB). A request may override both, up to *_MAX.
JUDGE0_CPU_TIME_LIMIT=120
JUDGE0_MEMORY_LIMIT=1024000
JUDGE0_CPU_TIME_LIMIT_MAX=900
JUDGE0_MEMORY_LIMIT_MAX=4096000
JUDGE0_WALL_TIME_MARGIN=60
JUDGE0_WALL_TIME_MAX=1800
# Reconciler sweep interval, and how long a run may sit PROCESSING before it is
# declared FAILED.
JUDGE0_POLL_INTERVAL_MS=2000
JUDGE0_MAX_WAIT_MS=1900000

# ------------------------------------------------------------------ artifacts
ARTIFACT_MAX_TOTAL_BYTES=8388608
ARTIFACT_MAX_COUNT=20
ADDITIONAL_FILES_MAX_BASE64_BYTES=33554432

# ------------------------------------------------------------- abuse controls
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_RUNS=20
RATE_LIMIT_MAX_AUTH=20
MAX_CONCURRENT_RUNS_PER_USER=3
MAX_CONCURRENT_RUNS_TOTAL=12

# ---------------------------------------------------------------- agent (LLM)
# Groq chat model for the LangGraph reasoner. REQUIRED for agent chat.
# Get a key at https://console.groq.com/keys (never commit the real key).
GROQ_API_KEY=
# Model id on Groq � must support tool calling.
AGENT_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------- agent (embeddings)
# HuggingFace Inference API for MemoryArtifact vectors (optional but recommended).
HF_API_KEY=
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EXECUTOR_IMAGE_BASH=bash:5
