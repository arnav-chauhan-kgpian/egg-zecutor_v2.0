node_modules/
dist/
*.log
npm-debug.log*
.DS_Store
coverage/
*.tsbuildinfo

# Local editor/agent settings — machine-specific, not part of the project.
.claude/
.vscode/
.idea/

# Generated by setup.sh / setup.ps1 — contain real secrets, never commit.
.env
.env.docker
.env.*.local
deploy/judge0.conf

# Belt and braces: a stray copy of a secrets file must not slip through just
# because it has a different suffix.
*.backup
*.bak
.env.*
!.env.example
!.env.docker.example
!.env.local.example

# Derived from schema.prisma by `npm run dev` for the no-Docker (SQLite) mode.
prisma/schema.sqlite.prisma
prisma/*.db
prisma/*.db-journal
