# Production stack configuration. Copy to .env.docker and fill in the secrets.
#
#   cp .env.docker.example .env.docker
#   ./deploy.sh
#
# Compose is always invoked with `--env-file .env.docker` so this file does not
# collide with the development `.env`.

# ---------------------------------------------------------------- app database
POSTGRES_USER=postgres
POSTGRES_DB=hackerrank_clone
# REQUIRED — generate: openssl rand -hex 24
POSTGRES_PASSWORD=
# Host-side port for debugging (bound to 127.0.0.1 only). This is the ONLY
# place the host port is set — 5435 keeps clear of a local Postgres on
# 5432/5433 and of the port blocks Windows Hyper-V/WSL2 reserves.
POSTGRES_PORT=5435

# Consumed by the api and migrate services. Host is the Compose service name,
# and the port is the CONTAINER port 5432 — it must NOT track POSTGRES_PORT,
# which only remaps the host side of the binding.
# Keep the credentials in sync with POSTGRES_* above.
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/hackerrank_clone?schema=public

# ------------------------------------------------------------------------ auth
# REQUIRED, min 32 chars — generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ----------------------------------------------------------------- http / cors
API_PORT=4000
WEB_PORT=3000

# Published ports bind here. Loopback by default: the api container holds the
# docker socket, so exposing it on 0.0.0.0 hands that trust boundary to your
# whole network. Change only if you deliberately want remote access.
BIND_ADDRESS=127.0.0.1

# Abuse controls for a shared demo.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_RUNS=20
RATE_LIMIT_MAX_AUTH=20
MAX_CONCURRENT_RUNS_PER_USER=3
MAX_CONCURRENT_RUNS_TOTAL=12

# Lock this down in production, e.g. https://codearena.example.com
CORS_ORIGIN=*

# Browser-facing API URL. Inlined into the client bundle at BUILD time, so
# changing it requires `./deploy.sh --build`. Must be reachable from the user's
# browser — in production this is your public API hostname.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-side (SSR) API URL, resolved inside the Docker network.
API_INTERNAL_URL=http://api:4000

# ---------------------------------------------------------------------- judge0
JUDGE0_VERSION=1.13.1
JUDGE0_PORT=2358

# Leave EMPTY for mock grading (code is not executed). The judge0 services are
# behind the `judge0` Compose profile and do not start by default, because
# Judge0 1.13.x requires cgroup v1 — on a cgroup v2 host (Docker Desktop/WSL2,
# modern Linux) every submission returns Internal Error.
#
# On a cgroup v1 host, set http://judge0-server:2358, set EXECUTOR=judge0, and:
#   docker compose --env-file .env.docker --profile judge0 up -d
JUDGE0_API_URL=

# Webhook Judge0 posts finished submissions to. Resolved FROM the judge0-server
# container, so it must be the Compose service name — not localhost, which
# inside that container is Judge0 itself.
JUDGE0_CALLBACK_URL=http://api:4000/api/v1/executions/callback
# Shared secret checked on that route. setup.sh / setup.ps1 fill this in — the
# route mutates execution records from an unauthenticated request.
JUDGE0_CALLBACK_SECRET=

# Judge0's own batch-submission ceiling (rendered into deploy/judge0.conf).
JUDGE0_MAX_BATCH_SIZE=20

# ------------------------------------------------------------------ run limits
# Research defaults, far above competitive-programming values. A single request
# may override both, up to the *_MAX ceilings.
#
# When EXECUTOR=judge0 these must ALSO fit inside the MAX_* values in
# deploy/judge0.conf, or Judge0 rejects the submission with 422. Raise both
# together.
JUDGE0_CPU_TIME_LIMIT=120
JUDGE0_MEMORY_LIMIT=1024000
JUDGE0_CPU_TIME_LIMIT_MAX=900
JUDGE0_MEMORY_LIMIT_MAX=4096000
# Judge0 kills at wall time regardless of CPU time; I/O-bound jobs need slack.
JUDGE0_WALL_TIME_MARGIN=60
JUDGE0_WALL_TIME_MAX=1800
# Reconciler: sweep interval, and how long a run may sit PROCESSING before it
# is declared FAILED. Without this a lost callback hangs a run forever.
JUDGE0_POLL_INTERVAL_MS=2000
JUDGE0_MAX_WAIT_MS=1900000

# ------------------------------------------------------------------- artifacts
ARTIFACT_MAX_TOTAL_BYTES=8388608
ARTIFACT_MAX_COUNT=20
ADDITIONAL_FILES_MAX_BASE64_BYTES=33554432
REQUEST_BODY_LIMIT=64mb

# ------------------------------------------------------------------ executor
# docker — REAL execution in throwaway containers; works on cgroup v2.
#          Requires the docker socket mount on the api service.
# judge0 — use a Judge0 server (needs JUDGE0_API_URL and a cgroup v1 host)
# mock   — never execute; MOCK:* directives drive the verdict
EXECUTOR=docker
EXECUTOR_IMAGE_PYTHON=python:3.11-alpine
EXECUTOR_IMAGE_NODE=node:20-alpine
EXECUTOR_IMAGE_CPP=gcc:13
EXECUTOR_CPUS=1
EXECUTOR_PIDS_LIMIT=128
EXECUTOR_TMPFS_MB=64
EXECUTOR_CONCURRENCY=2
EXECUTOR_COMPILE_MEMORY_MB=1024
EXECUTOR_COMPILE_CPUS=2
EXECUTOR_COMPILE_TIMEOUT_S=30
EXECUTOR_MAX_OUTPUT_BYTES=4194304
EXECUTOR_STARTUP_GRACE_MS=15000

# NOTE: the per-run limits (JUDGE0_CPU_TIME_LIMIT / JUDGE0_MEMORY_LIMIT) are
# defined ONCE, in the "run limits" section above. Do not repeat them here —
# dotenv is last-assignment-wins, so a duplicate silently overrides the value
# you meant and pins every run back to the old competitive-programming caps.

# Number of concurrent judging workers. Set to the host's core count or lower.
JUDGE0_WORKER_COUNT=2

# Judge0's own datastores. REQUIRED — generate: openssl rand -hex 24
JUDGE0_POSTGRES_DB=judge0
JUDGE0_POSTGRES_USER=judge0
JUDGE0_POSTGRES_PASSWORD=
JUDGE0_REDIS_PASSWORD=

# Optional Judge0 auth tokens. Leave empty for an open instance (it is only
# published on loopback). If you set these, also set JUDGE0_API_KEY on the api
# service so it sends the header.
JUDGE0_AUTHN_TOKEN=
JUDGE0_AUTHZ_TOKEN=
EXECUTOR_IMAGE_BASH=bash:5
